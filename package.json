{
  "name": "@radical-intelligence/mailchimp-mcp-server",
  "version": "2.1.0",
  "description": "MCP server for the Mailchimp Marketing API with read and write support: audiences, campaigns, templates, reports, sending and scheduling",
  "author": "Radical Intelligence",
  "license": "MIT",
  "keywords": [
    "mailchimp",
    "api",
    "mcp",
    "server",
    "ai",
    "email",
    "campaigns",
    "templates"
  ],
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "mailchimp-mcp": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "start": "node build/http.js",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "prepare": "npm run build && npm run bundle",
    "watch": "tsc --watch",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.4.7",
    "express": "^4.22.2",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^20.11.24",
    "esbuild": "^0.25.0",
    "typescript": "^5.3.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/radical-intelligence/mailchimp-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/radical-intelligence/mailchimp-mcp/issues"
  },
  "homepage": "https://github.com/radical-intelligence/mailchimp-mcp#readme",
  "publishConfig": {
    "access": "public"
  }
}
